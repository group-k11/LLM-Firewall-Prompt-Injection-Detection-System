# =============================================================
# LLM Firewall — Environment Variables
# Copy this file: cp .env.example .env
# Then fill in your actual values below.
# =============================================================

# -----------------------------------------------
# OpenRouter (Primary Cloud LLM Provider)
# Get your key at: https://openrouter.ai/keys
# -----------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model to use via OpenRouter (default: gpt-4o-mini)
OPENROUTER_MODEL=openai/gpt-4o-mini

# -----------------------------------------------
# Ollama (Local Fallback LLM — optional)
# Run Ollama locally: https://ollama.com
# -----------------------------------------------
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# -----------------------------------------------
# LLM Settings
# -----------------------------------------------
# Timeout in seconds for LLM API calls
LLM_TIMEOUT=10
