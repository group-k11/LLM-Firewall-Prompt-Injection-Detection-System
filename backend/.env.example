# =============================================================
# LLM Firewall v2.0 — Environment Variables
# Copy this file: cp .env.example .env
# Then fill in your actual API keys below.
# =============================================================

# -----------------------------------------------
# Groq (PRIMARY LLM Provider — recommended)
# Ultra-fast inference, free tier available.
# Get your key at: https://console.groq.com/keys
# -----------------------------------------------
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama3-8b-8192

# -----------------------------------------------
# OpenRouter (Secondary Cloud Fallback)
# Get your key at: https://openrouter.ai/keys
# -----------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=openai/gpt-4o-mini

# -----------------------------------------------
# Ollama (Local Fallback — no API key needed)
# Run Ollama locally: https://ollama.com
# -----------------------------------------------
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# -----------------------------------------------
# LLM Settings
# -----------------------------------------------
LLM_TIMEOUT=10
